{
  "manifest_version": 3,
  "name": "Tabata Timer",
  "version": "0.3.0",
  "description": "Interval timer for Tabata workouts that lives in the Chrome side panel.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Tabata timer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage"]
}
